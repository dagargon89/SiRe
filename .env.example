# ─────────────────────────────────────────────────────────────
# SiRe — variables de entorno (plantilla). Copiar a .env y completar.
# NUNCA commitear el .env real ni el service account de Firebase.
# ─────────────────────────────────────────────────────────────

# --- Base de datos (MySQL en Docker) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sire
DB_USERNAME=sire
DB_PASSWORD=sire
DB_ROOT_PASSWORD=root

# --- Redis (en Docker) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- App / API (CodeIgniter) ---
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=America/Ciudad_Juarez
# Orígenes permitidos por CORS (coma-separados), p.ej. el dev server de Vite
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite, prefijo VITE_ para exponer al cliente) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# --- Firebase Admin (backend: verificación de token, revocación, Storage) ---
FIREBASE_PROJECT_ID=
# Ruta al JSON del service account (fuera de webroot; no commitear)
FIREBASE_CREDENTIALS=apps/api/writable/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=

# --- Correo (SMTP) — usado por el cron de alertas (Sprint 4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@planjuarez.org
SMTP_PASS=
SMTP_FROM=noreply@planjuarez.org
SMTP_CRYPTO=tls
